<mxfile host="app.diagrams.net"><diagram name="Use Case Diagram" id="uc"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ucc1" value="Fault &amp;amp; Furious Swarm" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=none;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="200" y="30" width="1130" height="1080" as="geometry"/></mxCell><mxCell id="ucc2" value="On-call Engineer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="90" y="230" width="30" height="60" as="geometry"/></mxCell><mxCell id="ucc3" value="Experiment Operator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="90" y="790" width="30" height="60" as="geometry"/></mxCell><mxCell id="ucc4" value="Telemetry Source" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1410" y="60" width="30" height="60" as="geometry"/></mxCell><mxCell id="ucc5" value="LLM Service&lt;br&gt;(Ollama or mock)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1410" y="450" width="30" height="60" as="geometry"/></mxCell><mxCell id="ucc6" value="Ingest telemetry" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1090" y="60" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc7" value="Replicate shard&lt;br&gt;(quorum write)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc8" value="Open incident" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1090" y="170" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc9" value="Investigate incident" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc10" value="Analyse local shard" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1090" y="280" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc11" value="Exchange belief state&lt;br&gt;(gossip and CRDT merge)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1090" y="370" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc12" value="Cross check hypothesis" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1090" y="460" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc13" value="Elect leader (Raft)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1090" y="550" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc14" value="Generate incident report" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1090" y="640" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc15" value="Diagnose production incident&lt;br&gt;(UC1)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="250" y="230" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc16" value="Monitor investigation" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc17" value="View incident report" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc18" value="Inspect evidence" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="830" y="160" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc19" value="Inject fault scenario" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="250" y="610" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc20" value="Inject chaos&lt;br&gt;(kill node, partition)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="250" y="720" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc21" value="Manage cluster membership" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="250" y="830" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc22" value="Run evaluation" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="250" y="965" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc23" value="Rebalance shards" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="830" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc24" value="Run centralized baseline" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="920" width="210" height="64" as="geometry"/></mxCell><mxCell id="ucc25" value="Compare with ground truth" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="1010" width="210" height="64" as="geometry"/></mxCell><mxCell id="uce26" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ucc2" target="ucc15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce27" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ucc3" target="ucc19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce28" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ucc3" target="ucc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce29" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ucc3" target="ucc21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce30" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ucc3" target="ucc22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce31" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ucc4" target="ucc6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce32" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ucc5" target="ucc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce33" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ucc5" target="ucc12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce34" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ucc5" target="ucc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce35" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc6" target="ucc7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce36" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc8" target="ucc9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce37" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc9" target="ucc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce38" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc9" target="ucc11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce39" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc9" target="ucc12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce40" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc9" target="ucc13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce41" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc9" target="ucc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce42" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc21" target="ucc23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce43" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc22" target="ucc24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce44" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc22" target="ucc25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce45" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc15" target="ucc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce46" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc15" target="ucc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce47" value="&amp;laquo;extend&amp;raquo;&lt;br&gt;[anomaly detected]" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc8" target="ucc6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uce48" value="&amp;laquo;extend&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="ucc18" target="ucc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Use Case Specification" id="sp"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="770" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="spc1" value="Use Case Specification: UC1 Diagnose production incident" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1070" height="40" as="geometry"/></mxCell><mxCell id="spc2" value="Use case" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="210" height="31" as="geometry"/></mxCell><mxCell id="spc3" value="UC1 Diagnose production incident" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="860" height="31" as="geometry"/></mxCell><mxCell id="spc4" value="Primary actor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="111" width="210" height="31" as="geometry"/></mxCell><mxCell id="spc5" value="On-call Engineer" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="111" width="860" height="31" as="geometry"/></mxCell><mxCell id="spc6" value="Supporting actors" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="142" width="210" height="31" as="geometry"/></mxCell><mxCell id="spc7" value="LLM Service (Ollama or mock model), Telemetry Source" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="142" width="860" height="31" as="geometry"/></mxCell><mxCell id="spc8" value="Goal" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="173" width="210" height="31" as="geometry"/></mxCell><mxCell id="spc9" value="The engineer gets the root cause of an outage with supporting evidence, without collecting logs, metrics and traces by hand." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="173" width="860" height="31" as="geometry"/></mxCell><mxCell id="spc10" value="Preconditions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="210" height="65" as="geometry"/></mxCell><mxCell id="spc11" value="The swarm cluster is running.&lt;br&gt;Telemetry is ingested, sharded and replicated on three nodes.&lt;br&gt;The engineer can open the dashboard." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="204" width="860" height="65" as="geometry"/></mxCell><mxCell id="spc12" value="Trigger" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="269" width="210" height="31" as="geometry"/></mxCell><mxCell id="spc13" value="The anomaly detector flags a metric anomaly, for example the checkout success rate drops from 0.91 to 0.34." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="269" width="860" height="31" as="geometry"/></mxCell><mxCell id="spc14" value="Main success scenario" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="210" height="201" as="geometry"/></mxCell><mxCell id="spc15" value="1. The system detects the anomaly and opens an incident, for example INC-4417.&lt;br&gt;2. The system puts an investigation task on the queue and shows an alert on the dashboard.&lt;br&gt;3. The engineer opens the incident on the dashboard.&lt;br&gt;4. Every node takes the task. Its shard agent reads only the local shard and proposes hypotheses with confidence and evidence ids.&lt;br&gt;5. Nodes exchange belief states by gossip, merge them and cross check the hypotheses of other agents against their own data.&lt;br&gt;6. The dashboard shows live progress: which agents are alive, the current hypotheses and their confidence.&lt;br&gt;7. The engineer opens a hypothesis to see the evidence records behind it, for example pg-150 and dep-1 (Inspect evidence).&lt;br&gt;8. The swarm converges when the top hypothesis passes the confidence threshold.&lt;br&gt;9. The elected leader writes the incident report: root cause, timeline, evidence and remediation.&lt;br&gt;10. The dashboard shows the report to the engineer.&lt;br&gt;11. The engineer reviews the root cause and the evidence and applies the recommended fix outside the system." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="300" width="860" height="201" as="geometry"/></mxCell><mxCell id="spc16" value="Alternative flows" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="501" width="210" height="116" as="geometry"/></mxCell><mxCell id="spc17" value="5a. A node fails or the network splits. The dashboard marks the agent as down. The remaining agents continue with the replicated shards and the belief states are merged again when the partition heals.&lt;br&gt;8a. The swarm does not converge before the timeout. The leader writes a report that lists the top hypotheses marked as low confidence and the engineer continues manually.&lt;br&gt;9a. The leader fails while writing the report. A new leader is elected with Raft and writes the report.&lt;br&gt;11a. The engineer does not agree with the diagnosis. The evidence list is used as the starting point for a manual investigation." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="501" width="860" height="116" as="geometry"/></mxCell><mxCell id="spc18" value="Postconditions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="617" width="210" height="48" as="geometry"/></mxCell><mxCell id="spc19" value="The incident has the status REPORTED.&lt;br&gt;The report and its evidence ids are stored and can be opened again from the dashboard." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="617" width="860" height="48" as="geometry"/></mxCell><mxCell id="spc20" value="Related use cases" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="210" height="65" as="geometry"/></mxCell><mxCell id="spc21" value="Includes: Monitor investigation, View incident report.&lt;br&gt;Extended by: Inspect evidence (step 7).&lt;br&gt;Runs together with the system use cases Open incident and Investigate incident (steps 1, 4, 5, 8, 9)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="665" width="860" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Activity Diagram" id="ac"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="3540" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="acc1" value="Activity Diagram: UC1 Diagnose production incident" style="swimlane;html=1;startSize=34;horizontal=1;fontStyle=1;fontSize=14;collapsible=0;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2000" height="3480" as="geometry"/></mxCell><mxCell id="acc2" value="On-call Engineer" style="swimlane;html=1;startSize=44;horizontal=1;fontStyle=1;collapsible=0;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="300" height="3446" as="geometry"/></mxCell><mxCell id="acc3" value="Dashboard" style="swimlane;html=1;startSize=44;horizontal=1;fontStyle=1;collapsible=0;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="54" width="240" height="3446" as="geometry"/></mxCell><mxCell id="acc4" value="Telemetry and Detection" style="swimlane;html=1;startSize=44;horizontal=1;fontStyle=1;collapsible=0;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="580" y="54" width="240" height="3446" as="geometry"/></mxCell><mxCell id="acc5" value="Task Queue" style="swimlane;html=1;startSize=44;horizontal=1;fontStyle=1;collapsible=0;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="54" width="240" height="3446" as="geometry"/></mxCell><mxCell id="acc6" value="Swarm Node (ShardAgent)" style="swimlane;html=1;startSize=44;horizontal=1;fontStyle=1;collapsible=0;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1060" y="54" width="240" height="3446" as="geometry"/></mxCell><mxCell id="acc7" value="LLM Service" style="swimlane;html=1;startSize=44;horizontal=1;fontStyle=1;collapsible=0;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1300" y="54" width="240" height="3446" as="geometry"/></mxCell><mxCell id="acc8" value="Coordination (Gossip, CRDT, Failure Detector)" style="swimlane;html=1;startSize=44;horizontal=1;fontStyle=1;collapsible=0;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1540" y="54" width="260" height="3446" as="geometry"/></mxCell><mxCell id="acc9" value="Raft Leader" style="swimlane;html=1;startSize=44;horizontal=1;fontStyle=1;collapsible=0;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1800" y="54" width="240" height="3446" as="geometry"/></mxCell><mxCell id="acc10" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="685.0" y="105.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="acc11" value="Monitored application emits OTLP logs, metrics and traces" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="605.0" y="173.0" width="190" height="54" as="geometry"/></mxCell><mxCell id="acc12" value="Ingest telemetry records" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="605.0" y="263.0" width="190" height="54" as="geometry"/></mxCell><mxCell id="acc13" value="Place shards on the hash ring and write 3 replicas (quorum 2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="605.0" y="353.0" width="190" height="54" as="geometry"/></mxCell><mxCell id="acc14" value="Check metrics with z-score or EWMA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="605.0" y="443.0" width="190" height="54" as="geometry"/></mxCell><mxCell id="acc15" value="Anomaly found?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620.0" y="530.0" width="160" height="80" as="geometry"/></mxCell><mxCell id="acc16" value="1. Open incident INC-4417 (status OPEN)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="605.0" y="653.0" width="190" height="54" as="geometry"/></mxCell><mxCell id="acc17" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="380.0" y="757" width="640.0" height="6" as="geometry"/></mxCell><mxCell id="acc18" value="2. alert(incident): new incident" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365.0" y="813.0" width="190" height="54" as="geometry"/></mxCell><mxCell id="acc19" value="2. Enqueue investigation task" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845.0" y="813.0" width="190" height="54" as="geometry"/></mxCell><mxCell id="acc20" value="Receive the alert" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="95.0" y="903.0" width="190" height="54" as="geometry"/></mxCell><mxCell id="acc21" value=":InvestigationTask" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860.0" y="912.0" width="160" height="36" as="geometry"/></mxCell><mxCell id="acc22" value="4. Consume the task" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1085.0" y="903.0" width="190" height="54" as="geometry"/></mxCell><mxCell id="acc23" value="3. Open the incident view" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=11;" vertex="1" parent="